# RoyalSauna — environment variables
# Skopiuj ten plik do .env.local i uzupełnij wartości.

# Pełny adres produkcyjny strony (bez końcowego ukośnika), np. https://royalsauna.pl
NEXT_PUBLIC_SITE_URL=

# Meta (Facebook) Pixel ID — np. 123456789012345
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity Project ID — np. abcdefghij
NEXT_PUBLIC_CLARITY_ID=

# Cookiebot Domain Group ID — https://admin.cookiebot.com (Settings → Your scripts)
# Steruje banerem zgody i automatycznie blokuje GTM/Pixel/Clarity do czasu zgody.
NEXT_PUBLIC_COOKIEBOT_ID=

# Włącz własny widget asystenta głosowego (true|false)
NEXT_PUBLIC_ENABLE_AI_AGENT=false

# ElevenLabs Conversational AI — tylko serwer (signed URL). Nigdy NEXT_PUBLIC_*.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=agent_7901m1edhvkne7dbqs6ccywj3v0w

# Resend — wysyłka maila powitalnego z VSL i powiadomienia dla biura po wypełnieniu formularza
# https://resend.com/api-keys
RESEND_API_KEY=

# Nadawca maili z formularza. Wymaga zweryfikowanej domeny w Resend
# (resend.com/domains) — inaczej maile pójdą tylko na adres właściciela konta.
OFFER_EMAIL_FROM=RoyalSauna <oferta@royalsauna.pl>

# Link do strony z filmem VSL wysyłany w mailu powitalnym do klienta.
# Puste = domyślnie <NEXT_PUBLIC_SITE_URL>/film (dla EN: /en/film).
WELCOME_VSL_URL=

# Adres biura — dostaje osobne powiadomienie z danymi klienta i wybranym modelem
# (nie BCC maila klienta). Ustaw też w Vercel → Environment Variables.
OFFER_NOTIFY_TO=biuro@royalsauna.pl

# RoyalSauna CRM — wyłącznie po stronie serwera.
# Adres bazowy bez końcowego ukośnika, np. https://crm.example.com
CRM_API_URL=
# Klucz integracji w formacie public_key_id.secret
CRM_INTEGRATION_TOKEN=
